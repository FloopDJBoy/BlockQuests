<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="18dp">

    <!-- TITLE -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NEW VARIABLE"
        android:textColor="@color/primary_action"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingBottom="12dp" />

    <!-- CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#252526"
        android:padding="14dp">

        <!-- NAME LABEL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Variable name"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <!-- NAME INPUT -->
        <EditText
            android:id="@+id/variableNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter variable name..."
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="@color/primary_action"
            android:inputType="text"
            android:maxLines="1"
            android:paddingBottom="12dp" />

        <!-- SCOPE LABEL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scope"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <!-- LOCAL / GLOBAL -->
        <RadioGroup
            android:id="@+id/scopeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <RadioButton
                android:id="@+id/localRadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Local"
                android:textColor="#FFFFFF"
                android:buttonTint="@color/primary_action" />

            <RadioButton
                android:id="@+id/globalRadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Global"
                android:textColor="#FFFFFF"
                android:buttonTint="@color/primary_action" />
        </RadioGroup>

        <!-- TYPE LABEL -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingBottom="6dp" />

        <!-- TYPE DROPDOWN -->
        <!-- easy to add more later -->
        <Spinner
            android:id="@+id/typeSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/primary_action"
            android:popupBackground="#2F2F2F" />

    </LinearLayout>

    <!-- BUTTON ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/cancelBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#B0B0B0"
            android:backgroundTint="#3C3C3C"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/createBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Create"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/primary_action"
            android:layout_marginStart="6dp" />

    </LinearLayout>

</LinearLayout>